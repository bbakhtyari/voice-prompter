<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <com.voiceprompter.fa.NoFlingScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadingEdge="none"
        android:focusable="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <TextView
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="rtl"
            android:textAlignment="viewStart"
            android:textColor="#FFFFFFFF"
            android:textDirection="anyRtl"
            android:textSize="48sp" />
    </com.voiceprompter.fa.NoFlingScrollView>

    <!-- shows which line is being read -->
    <View
        android:id="@+id/marker"
        android:layout_width="14dp"
        android:layout_height="5dp"
        android:layout_gravity="top|left"
        android:background="@drawable/marker" />

    <!-- microphone level -->
    <View
        android:id="@+id/level"
        android:layout_width="90dp"
        android:layout_height="4dp"
        android:layout_gravity="top|right"
        android:layout_marginTop="6dp"
        android:layout_marginRight="10dp"
        android:background="#FF4CAF50"
        android:visibility="gone" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_marginTop="14dp"
        android:layout_marginRight="10dp"
        android:background="#99000000"
        android:paddingLeft="8dp"
        android:paddingTop="2dp"
        android:paddingRight="8dp"
        android:paddingBottom="2dp"
        android:textColor="#FFBBBBBB"
        android:textDirection="anyRtl"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <!-- what the recogniser heard (for checking accuracy) -->
        <TextView
            android:id="@+id/heard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#99000000"
            android:ellipsize="start"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingTop="3dp"
            android:paddingRight="12dp"
            android:paddingBottom="3dp"
            android:singleLine="true"
            android:textColor="#FF9E9E9E"
            android:textDirection="anyRtl"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#E6101010"
            android:gravity="center_vertical"
            android:layoutDirection="ltr"
            android:orientation="horizontal"
            android:paddingLeft="6dp"
            android:paddingRight="6dp">

            <Button
                android:id="@+id/btnClose"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:focusable="false"
                android:text="✕"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnMode"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.6"
                android:focusable="false"
                android:textColor="#FFFFC107"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnSlower"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:focusable="false"
                android:text="−"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/speedLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="center"
                android:textColor="#FFCCCCCC"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnFaster"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:focusable="false"
                android:text="+"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btnPlay"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.6"
                android:focusable="false"
                android:textColor="#FFFFC107"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btnFontDown"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:focusable="false"
                android:text="A−"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnFontUp"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:focusable="false"
                android:text="A+"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnMirror"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:focusable="false"
                android:text="آینه"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
